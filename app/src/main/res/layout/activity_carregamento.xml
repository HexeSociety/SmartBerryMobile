<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F2"
    tools:context=".CarregamentoActivity">

    <!-- Bolha Superior Esquerda -->
    <ImageView
        android:id="@+id/imgBolhasUp"
        android:layout_width="174dp"
        android:layout_height="178dp"
        android:scaleType="fitStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bolhas_up" />

    <!-- Bolha Inferior Direita (Fixa estritamente no canto inferior) -->
    <ImageView
        android:id="@+id/imgBolhasDown"
        android:layout_width="426dp"
        android:layout_height="335dp"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/bolhas_down" />

    <!-- Logótipo (Posicionado no terço superior, livre de sobreposições) -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="110dp"
        android:layout_height="100dp"
        android:layout_marginTop="170dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_clara" />

    <!-- Título SmartBerry -->
    <TextView
        android:id="@+id/txtTitleSmartBerry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SmartBerry"
        android:textColor="#7A00C0"
        android:textSize="26sp"
        app:layout_constraintEnd_toStartOf="@+id/txtTitle360"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogo" />

    <!-- Título 360° -->
    <TextView
        android:id="@+id/txtTitle360"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="360°"
        android:textColor="#38A635"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/txtTitleSmartBerry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtTitleSmartBerry"
        app:layout_constraintTop_toTopOf="@+id/txtTitleSmartBerry" />

    <!-- Subtítulo 1 -->
    <TextView
        android:id="@+id/txtSubtitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/k2d_medium"
        android:text="Gestão inteligente para sua estufa"
        android:textColor="#7A00C0"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTitleSmartBerry" />

    <!-- Subtítulo 2 -->
    <TextView
        android:id="@+id/txtSubtitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/k2d_semibold"
        android:text="TECNOLOGIA &amp; AGRICULTURA"
        android:textColor="#000000"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSubtitle1" />

</androidx.constraintlayout.widget.ConstraintLayout>